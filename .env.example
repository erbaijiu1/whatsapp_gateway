APP_PORT=8011
# 指向报价服务的 API 根地址；网关与报价服务同网络时可改为容器服务名
AGENT_BASE_URL=http://host.docker.internal:8010/logistics_ai_agent/api
# 各生成一个不同的随机令牌，至少32字符；不能使用示例文字
AGENT_INGRESS_TOKEN=
GATEWAY_SEND_TOKEN=
# 生产环境使用压缩为单行的 JSON；支持配置多个 WhatsApp 账号。
ACCOUNTS_JSON='[{"account_code":"default","phone_number_id":"REPLACE_WITH_META_PHONE_NUMBER_ID","access_token":"REPLACE_WITH_META_ACCESS_TOKEN","verify_token":"REPLACE_WITH_YOUR_WEBHOOK_VERIFY_TOKEN","app_secret":"REPLACE_WITH_META_APP_SECRET"}]'
# 未设置 ACCOUNTS_JSON 时，才从此文件读取（主要用于测试或本地开发）。
ACCOUNTS_FILE=config/accounts.json
DATA_DIR=data
# 与现项目默认版本一致，可按 Meta 应用配置调整
GRAPH_API_VERSION=v23.0
REQUEST_TIMEOUT_SECONDS=10
# 使用 deploy/compose.network.yml 时必填，取报价服务所在网络的真实名称
SHARED_NETWORK=
